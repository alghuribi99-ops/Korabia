{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "korabia",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": { "HF_ENV": "production", "APP_SLUG": "korabia" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "korabia-db",
      "database_id": "a2bcfbe1-bda8-42c0-8c67-82fbcb03333f"
    }
  ],
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "korabia-assets" }]
}
